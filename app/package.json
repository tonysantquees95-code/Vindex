{
  "name": "@vindex/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "node scripts/copiar-ocr.mjs && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test teste/*.test.mjs",
    "test:visual": "node teste-visual/telas.mjs",
    "test:portao": "node teste-visual/portao-pdf.mjs",
    "build:pdf": "node scripts/copiar-ocr.mjs && tsc -p tsconfig.json && vite build -c vite.pdf.config.ts && node scripts/montar-pdf-web.mjs",
    "dev:pdf": "vite -c vite.pdf.config.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
