{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vindex",
  "version": "1.0.0",
  "identifier": "tech.vetorial.vindex",
  "build": {
    "beforeBuildCommand": "cd ../app && npm run build",
    "beforeDevCommand": "cd ../app && npm run dev",
    "devUrl": "http://localhost:5177",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vindex · Manager e Vault",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://venus-servidor.tonysantquees95.workers.dev ipc: http://ipc.localhost; img-src 'self' data: blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Documento PDF", "description": "Documento PDF", "role": "Viewer" },
      { "ext": ["docx"], "name": "Documento do Word", "description": "Documento do Word", "role": "Editor" },
      { "ext": ["xlsx"], "name": "Planilha do Excel", "description": "Planilha do Excel", "role": "Editor" },
      { "ext": ["pptx"], "name": "Apresentação do PowerPoint", "description": "Apresentação do PowerPoint", "role": "Editor" },
      { "ext": ["csv"], "name": "Tabela CSV", "description": "Tabela CSV", "role": "Editor" }
    ],
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "installerHooks": "./instalador.nsh"
      }
    }
  }
}